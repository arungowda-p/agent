# ---------------------------------------------------------------------------
# Agent Suite configuration. Every variable is optional: with none set, the
# suite runs locally in "extractive mode" (no LLM, hashing embeddings, JSON files).
# ---------------------------------------------------------------------------

# LLM — any OpenAI-compatible endpoint. Default: Google Gemini free tier.
# Get a key at https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Fallback provider used when the primary is rate limited. Default: Groq free tier.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# Embeddings. Defaults to the LLM key/base URL when left empty.
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768

# Postgres + pgvector (free Supabase or Neon project). REQUIRED on Vercel,
# because serverless instances do not share a filesystem.
DATABASE_URL=

# Local file storage root (defaults to backend/data, or /tmp on Vercel).
DATA_DIR=
MAX_UPLOAD_MB=25

# Auth. JSON map of API key -> tenant id. When set, the X-Tenant-ID dev header is disabled.
# API_KEYS={"sk_live_acme_123":"acme","sk_live_globex_456":"globex"}
API_KEYS=
ALLOW_DEV_TENANT_HEADER=true

# Comma separated list, or * for any.
CORS_ORIGINS=*

# Frontend: point at a separately hosted API (leave empty when same origin).
VITE_API_BASE=
